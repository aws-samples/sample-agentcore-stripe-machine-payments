AWS_REGION=us-east-1
PAYMENT_USER_ID=agentcore-user

# Step 2 — Add the HTTP 402 Paid API (api/)
# mppx accepts decimal currency amounts: 1 is $1.00; 0.01 is $0.01.
MPP_AMOUNT=0.01
MPP_REALM=workshop-x402-api
# Generate with: openssl rand -base64 32
MPP_SECRET_KEY=
STRIPE_LIVEMODE=false
STRIPE_PROFILE_ID=stripe_test_xxx
STRIPE_SECRET_KEY=
# Public facilitator for Base Sepolia workshop payments only.
# Use an authenticated mainnet-compatible facilitator for live payments.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Step 4 — Create Your Privy App & Authorization Key
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
PRIVY_KEY_ID=your-privy-authorization-id
PRIVY_PRIVATE_KEY=your-privy-authorization-private-key-without-the-wallet-auth-prefix

# Step 5 — Create an AgentCore Payment Manager + Connector
AWS_ACCESS_KEY=your-aws-access-key-id
AWS_SECRET_KEY=your-aws-secret-access-key
PAYMENT_MANAGER_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:payment-manager/your-payment-manager
CONNECTOR_ID=your-connector-id
END_USER_EMAIL=you@example.com

# Step 6 — after running main/1_create_payment_instrument_wallet.py
PAYMENT_INSTRUMENT_ID=payment-instrument-xxxx
WALLET_ADDRESS=0xYourWalletAddress

# Step 9 — after running main/2_create_payment_session.py
PAYMENT_SESSION_ID=payment-session-xxxx
